APP_NAME=CrossBorder AI Copilot
DEBUG=false

DATABASE_URL=postgresql+asyncpg://crossborder:password@localhost:5432/crossborder
DATABASE_URL_SYNC=postgresql://crossborder:password@localhost:5432/crossborder

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Model Configuration ──────────────────────────────────────────────────────
# Provider: "anthropic" (default) or "openai" (for any OpenAI-compat endpoint)
MODEL_PROVIDER=anthropic

# Base URL — change to use any provider:
#   Anthropic:  https://api.anthropic.com
#   OpenAI:     https://api.openai.com/v1
#   DeepSeek:   https://api.deepseek.com/v1
#   Ollama:     http://localhost:11434/v1
MODEL_BASE_URL=https://api.anthropic.com

# API Key for the selected provider
MODEL_API_KEY=sk-ant-...

# Model name
MODEL_NAME=claude-sonnet-4-6

# ── web-access CDP proxy ─────────────────────────────────────────────────────
# URL of the local CDP proxy started by web-access skill
CDP_PROXY_URL=http://localhost:3456
# Set to false to skip CDP and use web_search tool only
CDP_ENABLED=true

FRONTEND_URL=http://localhost:3000
